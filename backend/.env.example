PORT=5000
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# First admin account, auto-created on first server start if it doesn't exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://your-app.up.railway.app,http://localhost:5500
FRONTEND_ORIGIN=

# The platform's USDT (BEP20) wallet address that users are told to send
# deposits to. Shown on the deposit page.
ADMIN_USDT_BEP20_ADDRESS=0xYourPlatformReceivingAddressHere

# Path to the SQLite file. Point this at a mounted persistent volume in
# production (e.g. /data/app.db) so data survives redeploys.
DB_PATH=
